{
    "name": "commodo-worker-microbalances-service",
    "version": "0.0.1",
    "description": "Headless worker that applies loyalty microbalances from an SQS queue subscribed to SNS",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@10.14.0",
    "scripts": {
        "test": "jest --runInBand",
        "prebuild": "rimraf dist",
        "build": "nest build microbalances-worker",
        "start": "nest start microbalances-worker",
        "start:dev": "nest start microbalances-worker --watch",
        "start:prod": "node dist/apps/microbalances-worker/main",
        "typecheck": "tsc -p tsconfig.check.json --noEmit --pretty false",
        "typecheck:watch": "tsc -p tsconfig.check.json --noEmit --watch",
        "lint": "eslint apps libs *.js *.cjs --cache --cache-location .cache/eslint --max-warnings 0",
        "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\" \"*.js\" \"*.cjs\" \"*.json\"",
        "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"*.js\" \"*.cjs\" \"*.json\"",
        "test:watch": "jest --watch --maxWorkers=2",
        "test:cov": "jest --runInBand --coverage",
        "typeorm": "node scripts/typeorm-cli.cjs",
        "migration:show:default": "pnpm typeorm migration:show -d libs/db-managment/src/migrations-datasources/default.datasource.ts",
        "migration:run:default": "pnpm typeorm migration:run -d libs/db-managment/src/migrations-datasources/default.datasource.ts",
        "migration:revert:default": "pnpm typeorm migration:revert -d libs/db-managment/src/migrations-datasources/default.datasource.ts"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.1140.0",
        "@aws-sdk/client-sqs": "^3.830.0",
        "@aws-sdk/credential-providers": "^3.1140.0",
        "@aws-sdk/node-http-handler": "^3.374.0",
        "@commodo-sas/shared-libs": "4.1.0",
        "@nestjs/common": "^10.3.3",
        "@nestjs/config": "^3.2.0",
        "@nestjs/core": "^10.3.3",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^7.3.0",
        "@nestjs/typeorm": "^10.0.2",
        "body-parser": "^1.20.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.4.4",
        "moment-timezone": "^0.6.4",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@swc/core": "1.16.2",
        "@swc/jest": "0.2.39",
        "@types/express": "^4.17.17",
        "@types/jest": "29.5.14",
        "@types/node": "^24.19.0",
        "eslint": "10.11.0",
        "jest": "29.7.0",
        "prettier": "3.9.9",
        "rimraf": "^6.0.1",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3",
        "typescript-eslint": "8.71.0",
        "webpack": "^5.111.1"
    },
    "engines": {
        "node": ">=24 <25",
        "pnpm": "10.14.0"
    }
}
